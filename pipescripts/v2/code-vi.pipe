//@version=5
indicator("Hybrid Trading System - Zone Engine V4", overlay=true, max_boxes_count=150, max_labels_count=300, max_lines_count=200)

// =====================================================
// 1) DATA MODEL
// =====================================================
type Zone
    float top
    float bottom
    int   start_bar
    int   zone_type       // 1 = Demand, -1 = Supply
    int   touch_count
    float strength_score
    bool  is_active
    bool  is_triggered
    box   box_id

// =====================================================
// 2) INPUTS
// =====================================================

// ── Pivot & Zones ──
grp_zone = "🧱 Cài Đặt Vùng Cản (Zones)"
pivot_left  = input.int(20, "Số nến dò Đỉnh/Đáy (Trái)",  minval=1, group=grp_zone)
pivot_right = input.int(5,  "Số nến dò Đỉnh/Đáy (Phải)", minval=1, group=grp_zone)
zone_width_mode   = input.string("ATR", "Cách tính Rộng Vùng Cản", options=["ATR","Percent"], group=grp_zone)
zone_width_pct    = input.float(0.5, "Độ Rộng Vùng (%)", minval=0.1, step=0.1, group=grp_zone) / 100.0
atr_length        = input.int(14, "Chu kỳ ATR", minval=1, group=grp_zone)
atr_zone_mult     = input.float(0.5, "Hệ số ATR Vùng Cản", minval=0.1, step=0.1, group=grp_zone)
max_active_zones  = input.int(12, "Số Vùng Cản Tối Đa", minval=1, maxval=50, group=grp_zone)
min_zone_distance = input.float(0.4, "Khoảng cách Vùng mới Min (ATR)", minval=0.1, step=0.1, group=grp_zone)
req_imbalance     = input.bool(false, "Chỉ lấy Vùng có FVG/Imbalance mạnh", tooltip="Yêu cầu nến ngay sau đỉnh/đáy phải là nến có thân lớn hơn 0.8 ATR để đảm bảo đó là lực đẩy của Cá mập, không phải pullback yếu.", group=grp_zone)

// ── Regime ──
ema_length = input.int(200, "Chu kỳ EMA Xu hướng", minval=1)

// ── Trigger ──
grp_trigger = "🎯 Điều Kiện Vào Lệnh (Trigger)"
use_regime_filter  = input.bool(true,  "Bật Lọc Thuận Xu Hướng EMA", group=grp_trigger)
first_touch_only   = input.bool(true,  "Chỉ Giao Dịch Chạm Lần Đầu", group=grp_trigger)
min_body_atr_ratio = input.float(0.20, "Tỉ lệ Thân Nến Tối Thiểu / ATR", minval=0.0, step=0.05, group=grp_trigger)
wick_to_body_ratio = input.float(2.0,  "Độ dài Râu / Thân tối thiểu", minval=1.0, step=0.25, group=grp_trigger)
require_bull_close = input.bool(true,  "Yêu cầu Đóng nến Xanh để MUA", group=grp_trigger)
require_bear_close = input.bool(true,  "Yêu cầu Đóng nến Đỏ để BÁN", group=grp_trigger)
label_signals      = input.bool(true,  "Hiện Nhãn Tín Hiệu", group=grp_trigger)
delete_invalidated_boxes = input.bool(false, "Xoá Hộp bị thủng (Thay vì Mờ Hệ số)", group=grp_trigger)

// ── Trend Signal ──
grp_trend = "📈 Cài Đặt Tín Hiệu Trend"
show_trend_bg      = input.bool(true, "Hiện màu nền Xu hướng",        group=grp_trend)
show_trend_signals = input.bool(true, "Hiện Mũi tên Mua/Bán theo trend",group=grp_trend)
trend_confirm_bars = input.int(3, "Số nến xác nhận Trend mạnh", minval=1, maxval=20, group=grp_trend)

// ── Future Prediction & Win-Rate ──
grp_future = "🔮 Dự Báo & Thống Kê Tỉ Lệ Thắng"
show_future_pred = input.bool(true, "Hiện Dự Báo Đường Đi Tương Lai", group=grp_future)
future_sessions  = input.int(5,  "Số nến Dự báo tới", group=grp_future, minval=1, maxval=50)
pred_line_style  = input.string("Dashed", "Kiểu Nét Đường Dự Báo", options=["Dashed","Dotted","Solid"], group=grp_future)
show_winrate_label  = input.bool(true, "Hiện Nhãn Tỉ Lệ Thắng", group=grp_future)
winrate_min_samples = input.int(3, "Mẫu số Lệnh Tối Thiểu", minval=1, maxval=50, group=grp_future)
winrate_source      = input.string("Both", "Đánh giá theo loại lệnh", options=["Both","Buy Only","Sell Only"], group=grp_future)

// ── Bollinger Bands ──
grp_bb = "🟦 Dải Bollinger Bands"
bb_length      = input.int(20,    "Chu Kỳ",        group=grp_bb, minval=1)
bb_ma_type     = input.string("SMA", "Loại MA Cơ sở", group=grp_bb, options=["SMA","EMA","SMMA (RMA)","WMA","VWMA"])
bb_src         = input(close,     "Nguồn Giá",        group=grp_bb)
bb_mult        = input.float(2.0, "Độ lệch chuẩn (StdDev)",        group=grp_bb, minval=0.001, maxval=50, step=0.1)
bb_offset      = input.int(0,     "Độ dịch dải BB",        group=grp_bb, minval=-500, maxval=500)
bb_filter_buy  = input.bool(true, "Lọc MUA: giá đóng ≤ BB dưới",  group=grp_bb)
bb_filter_sell = input.bool(true, "Lọc BÁN: giá đóng ≥ BB trên", group=grp_bb)

// ── #1 Risk Management: SL / TP ──
grp_risk = "🛡 Quản Trị Rủi Ro"
show_sl_tp     = input.bool(true,  "Hiện Đường Cắt Lỗ/Chốt Lời", group=grp_risk)
sl_atr_mult    = input.float(1.5,  "Hệ số Multiplier SL ATR",  group=grp_risk, minval=0.1, step=0.1)
rr_ratio_1     = input.float(1.0,  "Tỉ lệ Rủi ro:Lợi nhuận TP1",    group=grp_risk, minval=0.5, step=0.5)
rr_ratio_2     = input.float(2.0,  "Tỉ lệ Rủi ro:Lợi nhuận TP2",    group=grp_risk, minval=1.0, step=0.5)

// ── #1.5 Position Sizing ──
grp_pos = "💼 Tính Toán Khối Lượng Đầu Tư"
account_bal = input.float(10000.0,"Vốn Tài Khoản ($)", group=grp_pos, minval=100)
risk_pct    = input.float(1.0,    "Vốn Rủi ro / Lệnh Dịch (%)",  group=grp_pos, minval=0.1, step=0.1)
is_forex    = input.bool(false,   "Là tài sản Forex? (Chuyển Units sang Lot)", group=grp_pos, tooltip="Bật nếu giao dịch Forex để công thức tự quy đổi giá trị Pip thành Khối lượng hợp đồng (Lot).")

// ── #2 Volume Confirmation ──
grp_vol = "📊 Bộ Lọc Khối Lượng"
use_vol_filter = input.bool(false, "Yêu cầu có Dòng Tiền Đột Biến (Thận trọng với Forex)", group=grp_vol)
vol_ma_length  = input.int(20,   "Chu kỳ MA Khối Lượng",     group=grp_vol, minval=1)
vol_surge_mult = input.float(1.5,"Mức Khối lượng / Trung bình tối thiểu", group=grp_vol, minval=1.0, step=0.1)

// ── #3 Multi-Timeframe Trend ──
grp_mtf = "📡 Phân Tích Đa Khung"
use_mtf    = input.bool(true, "Yêu Cầu Thuận Xu Hướng Khung Lớn",    group=grp_mtf)
htf_mode   = input.string("Auto", "Chế độ Chọn Tự Động / Thủ Công", options=["Auto", "Custom"], group=grp_mtf, tooltip="Auto tự động lấy khung thời gian to hơn; Custom cho phép gán tay")
htf_custom = input.timeframe("1D", "Khung Lớn Tùy Chỉnh",    group=grp_mtf)
htf_ema_l  = input.int(200, "Chu kỳ EMA Khung Lớn",             group=grp_mtf, minval=1)

// ── #4 RSI Filter ──
grp_rsi = "📉 Bộ Lọc RSI"
use_rsi_filter = input.bool(true, "Bật Lọc Vùng RSI",     group=grp_rsi)
rsi_length     = input.int(14,    "Chu kỳ RSI",          group=grp_rsi, minval=1)
rsi_ob         = input.int(70,    "Biên Độ Quá Mua",    group=grp_rsi, minval=50, maxval=100)
rsi_os         = input.int(30,    "Biên Độ Quá Bán",      group=grp_rsi, minval=1,  maxval=50)

// ── #5 Confluence Score ──
grp_score = "⭐ Điểm Đánh Giá Lệnh"
min_score = input.int(2, "Số Điểm Hợp Lưu Tối Thiểu (0–6)", group=grp_score, minval=0, maxval=6, tooltip="Chỉ rải Tín Hiệu (Label) nếu số Điểm thỏa mãn mốc này")

// ── #6 Session Filter ──
grp_session = "🕐 Bộ Lọc Giờ Giao Dịch"
use_session_filter = input.bool(true, "Chỉ Giao Dịch Trong 2 Phiên", group=grp_session)
london_sess = input.session("0800-1600", "Khung Giờ London (Giờ UTC)",   group=grp_session)
ny_sess     = input.session("1300-2100", "Khung Giờ New York (Giờ UTC)", group=grp_session)

// =====================================================
// 3) STATE
// =====================================================
var Zone[] active_zones  = array.new<Zone>()
var bool buy_signal      = false
var bool sell_signal     = false
var int  bull_streak     = 0
var int  bear_streak     = 0
var bool trend_buy_signal  = false
var bool trend_sell_signal = false

// Future prediction
var line  future_line   = na
var label future_label  = na
var label winrate_label = na
var string last_signal_type  = "NONE"
var float  last_signal_price = na

// Win-rate buffer (Upgraded with SL tracking)
var int[]   wr_bars   = array.new<int>()
var float[] wr_prices = array.new<float>()
var float[] wr_sls    = array.new<float>()
var int[]   wr_dirs   = array.new<int>()
var int buy_wins   = 0
var int buy_total  = 0
var int sell_wins  = 0
var int sell_total = 0

// =====================================================
// 4) CORE SERIES
// =====================================================
atr_value  = ta.atr(atr_length)
ema_regime = ta.ema(close, ema_length)
is_uptrend   = close > ema_regime
is_downtrend = close < ema_regime

// ── Bollinger Bands ──
bb_ma(source, len, _type) =>
    switch _type
        "SMA"        => ta.sma(source, len)
        "EMA"        => ta.ema(source, len)
        "SMMA (RMA)" => ta.rma(source, len)
        "WMA"        => ta.wma(source, len)
        "VWMA"       => ta.vwma(source, len)
        => ta.sma(source, len)

bb_basis = bb_ma(bb_src, bb_length, bb_ma_type)
bb_dev   = bb_mult * ta.stdev(bb_src, bb_length)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

plot(bb_basis, "BB Basis", color=#2962FF,  offset=bb_offset)
bb_p1 = plot(bb_upper, "BB Upper", color=#F23645, offset=bb_offset)
bb_p2 = plot(bb_lower, "BB Lower", color=#089981, offset=bb_offset)
fill(bb_p1, bb_p2, title="BB Background", color=color.rgb(33, 150, 243, 95))

plot(ema_regime, color=color.gray, title="EMA Regime")

// ── #2 Volume ──
vol_ma  = ta.sma(volume, vol_ma_length)
vol_ok_global = use_vol_filter ? volume >= vol_ma * vol_surge_mult : true

// ── #3 HTF (Upgraded Non-Repainting) ──
get_auto_htf() =>
    string res = "D"
    if timeframe.isintraday
        if timeframe.multiplier <= 5
            res := "60"     // 5m -> 1H
        else if timeframe.multiplier <= 30
            res := "240"    // 15m/30m -> 4H
        else if timeframe.multiplier <= 240
            res := "D"      // 1H/4H -> 1D
        else
            res := "W"      // Intraday > 4H -> 1W
    else if timeframe.isdaily
        res := "W"          // 1D -> 1W
    else if timeframe.isweekly
        res := "M"          // 1W -> 1M
    res

actual_htf = htf_mode == "Auto" ? get_auto_htf() : htf_custom

// SỬ DỤNG [1] CỦA HTF KẾT HỢP LOOKAHEAD_ON ĐỂ CHỐNG REPAINTING 100%
htf_ema  = request.security(syminfo.tickerid, actual_htf, ta.ema(close, htf_ema_l)[1], lookahead=barmerge.lookahead_on)
htf_bull = close > htf_ema
htf_bear = close < htf_ema

// ── #4 RSI ──
rsi_val = ta.rsi(close, rsi_length)

// ── #6 Session ──
in_london = not na(time(timeframe.period, london_sess, "UTC"))
in_ny     = not na(time(timeframe.period, ny_sess,     "UTC"))
in_session = in_london or in_ny
// Only enforce session filters if the chart is an Intraday chart (<= 1 day)
is_intraday_chart = timeframe.isintraday
session_ok = use_session_filter and is_intraday_chart ? in_session : true

// ── #8 MACD Divergence ──
[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)

pl_macd = ta.pivotlow(macd_hist, 3, 3)
ph_macd = ta.pivothigh(macd_hist, 3, 3)

var float prev_pl_px = na
var float prev_pl_mc = na
if not na(pl_macd)
    prev_pl_px := low[3]
    prev_pl_mc := pl_macd

var float prev_ph_px = na
var float prev_ph_mc = na
if not na(ph_macd)
    prev_ph_px := high[3]
    prev_ph_mc := ph_macd

// Divergence triggers when current price forms new extreme but MACD does not
bull_div = close < prev_pl_px and macd_hist > prev_pl_mc and macd_hist < 0
bear_div = close > prev_ph_px and macd_hist < prev_ph_mc and macd_hist > 0

// Confirmed pivots
ph = ta.pivothigh(high, pivot_left, pivot_right)
pl = ta.pivotlow(low,  pivot_left, pivot_right)

// Reset per-bar signals
buy_signal        := false
sell_signal       := false
trend_buy_signal  := false
trend_sell_signal := false

// =====================================================
// 5) HELPERS
// =====================================================
get_zone_half_width(float price) =>
    zone_width_mode == "ATR" ? atr_value * atr_zone_mult : price * zone_width_pct

zone_mid(float top, float bottom) =>
    (top + bottom) * 0.5

is_zone_duplicate(float top, float bottom, int z_type) =>
    bool dup = false
    new_mid   = zone_mid(top, bottom)
    threshold = atr_value * min_zone_distance
    if array.size(active_zones) > 0
        for i = 0 to array.size(active_zones) - 1
            z = array.get(active_zones, i)
            if z.is_active and z.zone_type == z_type
                if math.abs(new_mid - zone_mid(z.top, z.bottom)) <= threshold
                    dup := true
                    break
    dup

create_zone(float pivot_price, int z_type) =>
    half_width = get_zone_half_width(pivot_price)
    z_top    = z_type == 1 ? pivot_price : pivot_price + half_width
    z_bottom = z_type == 1 ? pivot_price - half_width : pivot_price
    z_color  = z_type == 1 ? color.new(color.green, 82) : color.new(color.red, 82)
    z_box = box.new(
         left=time[pivot_right], top=z_top,
         right=time, bottom=z_bottom,
         xloc=xloc.bar_time,
         bgcolor=z_color,
         border_color=z_type == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
         border_style=line.style_dotted)
    // ── #7 Zone strength & Imbalance Check ──
    vol_bonus = volume[pivot_right] >= vol_ma * 1.5 ? 0.25 : 0.0
    Zone.new(z_top, z_bottom, bar_index[pivot_right], z_type, 0, 1.0 + vol_bonus, true, false, z_box)

is_zone_touched(Zone z) => low <= z.top and high >= z.bottom
is_zone_broken(Zone z)  => z.zone_type == 1 ? close < z.bottom : close > z.top

candle_body()  => math.abs(close - open)
upper_wick()   => high - math.max(open, close)
lower_wick()   => math.min(open, close) - low

// ── #5 Confluence scoring ──
buy_confluence_score(Zone z) =>
    int s = 0
    s += is_uptrend ? 1 : 0
    s += (use_mtf ? htf_bull : true) ? 1 : 0
    s += (use_rsi_filter ? rsi_val <= rsi_os : false) ? 1 : 0
    s += (use_vol_filter ? volume >= vol_ma * vol_surge_mult : false) ? 1 : 0
    s += z.touch_count <= 1 ? 1 : 0
    s += bull_div ? 1 : 0
    s

sell_confluence_score(Zone z) =>
    int s = 0
    s += is_downtrend ? 1 : 0
    s += (use_mtf ? htf_bear : true) ? 1 : 0
    s += (use_rsi_filter ? rsi_val >= rsi_ob : false) ? 1 : 0
    s += (use_vol_filter ? volume >= vol_ma * vol_surge_mult : false) ? 1 : 0
    s += z.touch_count <= 1 ? 1 : 0
    s += bear_div ? 1 : 0
    s

buy_trigger_from_zone(Zone z) =>
    body = candle_body()
    lw   = lower_wick()
    uw   = upper_wick()
    valid_body = body >= atr_value * min_body_atr_ratio
    close_ok   = require_bull_close ? close > open : true
    touch      = is_zone_touched(z)
    wick_ok    = lw >= body * wick_to_body_ratio and uw <= body
    close_outside_lower = close >= zone_mid(z.top, z.bottom)
    regime_ok  = use_regime_filter ? is_uptrend : true
    touch_ok   = first_touch_only  ? z.touch_count <= 1 : true
    bb_ok      = bb_filter_buy ? close <= bb_lower : true
    mtf_ok     = use_mtf ? htf_bull : true
    rsi_ok     = use_rsi_filter ? rsi_val <= rsi_os : true
    vol_ok     = use_vol_filter ? volume >= vol_ma * vol_surge_mult : true
    score      = buy_confluence_score(z)
    z.zone_type == 1 and touch and regime_ok and touch_ok and valid_body and close_ok and wick_ok and close_outside_lower and bb_ok and mtf_ok and rsi_ok and vol_ok and session_ok and score >= min_score

sell_trigger_from_zone(Zone z) =>
    body = candle_body()
    lw   = lower_wick()
    uw   = upper_wick()
    valid_body = body >= atr_value * min_body_atr_ratio
    close_ok   = require_bear_close ? close < open : true
    touch      = is_zone_touched(z)
    wick_ok    = uw >= body * wick_to_body_ratio and lw <= body
    close_outside_upper = close <= zone_mid(z.top, z.bottom)
    regime_ok  = use_regime_filter ? is_downtrend : true
    touch_ok   = first_touch_only  ? z.touch_count <= 1 : true
    bb_ok      = bb_filter_sell ? close >= bb_upper : true
    mtf_ok     = use_mtf ? htf_bear : true
    rsi_ok     = use_rsi_filter ? rsi_val >= rsi_ob : true
    vol_ok     = use_vol_filter ? volume >= vol_ma * vol_surge_mult : true
    score      = sell_confluence_score(z)
    z.zone_type == -1 and touch and regime_ok and touch_ok and valid_body and close_ok and wick_ok and close_outside_upper and bb_ok and mtf_ok and rsi_ok and vol_ok and session_ok and score >= min_score

fade_or_delete_zone(Zone z) =>
    if delete_invalidated_boxes
        box.delete(z.box_id)
    else
        box.set_bgcolor(z.box_id, color.new(color.gray, 90))
        box.set_border_color(z.box_id, color.gray)

// =====================================================
// 6) ZONE CREATION
// =====================================================
can_add_zone() => array.size(active_zones) < max_active_zones

if not na(ph)
    // Check FVG/Imbalance logic: look at the bar right after the pivot high
    body_after = math.abs(close[pivot_right - 1] - open[pivot_right - 1])
    is_imbal   = close[pivot_right - 1] < open[pivot_right - 1] and body_after > atr_value[pivot_right - 1] * 0.8
    if not req_imbalance or is_imbal
        half_width = get_zone_half_width(ph)
        new_top    = ph + half_width
        new_bottom = ph
        if can_add_zone() and not is_zone_duplicate(new_top, new_bottom, -1)
            array.push(active_zones, create_zone(ph, -1))

if not na(pl)
    // Check FVG/Imbalance logic: look at the bar right after the pivot low
    body_after = math.abs(close[pivot_right - 1] - open[pivot_right - 1])
    is_imbal   = close[pivot_right - 1] > open[pivot_right - 1] and body_after > atr_value[pivot_right - 1] * 0.8
    if not req_imbalance or is_imbal
        half_width = get_zone_half_width(pl)
        new_top    = pl
        new_bottom = pl - half_width
        if can_add_zone() and not is_zone_duplicate(new_top, new_bottom, 1)
            array.push(active_zones, create_zone(pl, 1))

// =====================================================
// 7) ZONE MANAGER + TRIGGER ENGINE
// =====================================================
if barstate.isconfirmed and array.size(active_zones) > 0
    for i = array.size(active_zones) - 1 to 0
        z = array.get(active_zones, i)
        box.set_right(z.box_id, time)

        if is_zone_touched(z)
            z.touch_count += 1
            decay = z.touch_count > 2 ? 0.25 : 0.15
            z.strength_score := math.max(0.0, z.strength_score - decay)

        broken = is_zone_broken(z)
        if broken
            z.is_active := false
            fade_or_delete_zone(z)
            array.remove(active_zones, i)
        else
            if not z.is_triggered
                buy_ok  = buy_trigger_from_zone(z)
                sell_ok = sell_trigger_from_zone(z)

                if buy_ok
                    z.is_triggered   := true
                    z.strength_score += 0.25
                    buy_signal       := true
                    b_score = buy_confluence_score(z)
                    stars   = b_score >= 5 ? "⭐⭐⭐⭐⭐" : b_score >= 4 ? "⭐⭐⭐⭐" : b_score >= 3 ? "⭐⭐⭐" : b_score >= 2 ? "⭐⭐" : "⭐"
                    
                    buy_sl = close - atr_value * sl_atr_mult
                    buy_tp1 = close + (close - buy_sl) * rr_ratio_1
                    buy_tp2 = close + (close - buy_sl) * rr_ratio_2
                    risk_amount = account_bal * (risk_pct / 100.0)
                    
                    // Forex PIP adjustment vs Crypto Base Unit
                    dist = math.abs(close - buy_sl)
                    units_to_buy = is_forex ? (risk_amount / (dist * 100000)) : (risk_amount / dist)
                    unit_label = is_forex ? "Lot: " : "Units: "
                    
                    lbl_text = "MUA " + stars + "\n" + unit_label + str.tostring(units_to_buy, "#.##") + "\nVô: " + str.tostring(close, format.mintick)
                    if label_signals
                        label.new(bar_index, low, lbl_text, color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small)
                        
                    if show_sl_tp
                        line.new(bar_index, buy_sl, bar_index + future_sessions, buy_sl, color=color.new(color.red, 20),   width=1, style=line.style_dashed)
                        line.new(bar_index, buy_tp1, bar_index + future_sessions, buy_tp1, color=color.new(color.orange, 20), width=1, style=line.style_dashed)
                        line.new(bar_index, buy_tp2, bar_index + future_sessions, buy_tp2, color=color.new(color.green, 20), width=1, style=line.style_dashed)
                        label.new(bar_index + future_sessions, buy_sl, "SL " + str.tostring(buy_sl, format.mintick), color=color.new(color.red, 20),   style=label.style_label_left, textcolor=color.white, size=size.small)
                        label.new(bar_index + future_sessions, buy_tp1, "TP1 " + str.tostring(buy_tp1, format.mintick), color=color.new(color.orange, 20), style=label.style_label_left, textcolor=color.white, size=size.small)
                        label.new(bar_index + future_sessions, buy_tp2, "TP2 " + str.tostring(buy_tp2, format.mintick), color=color.new(color.green, 20), style=label.style_label_left, textcolor=color.white, size=size.small)
                        
                    json_msg = "{\"action\": \"BUY\", \"symbol\": \"" + syminfo.ticker + "\", \"price\": " + str.tostring(close) + ", \"sl\": " + str.tostring(buy_sl) + ", \"tp1\": " + str.tostring(buy_tp1) + ", \"tp2\": " + str.tostring(buy_tp2) + ", \"size\": " + str.tostring(units_to_buy) + ", \"score\": " + str.tostring(b_score) + "}"
                    alert(json_msg, alert.freq_once_per_bar_close)

                if sell_ok
                    z.is_triggered   := true
                    z.strength_score += 0.25
                    sell_signal      := true
                    s_score = sell_confluence_score(z)
                    stars   = s_score >= 5 ? "⭐⭐⭐⭐⭐" : s_score >= 4 ? "⭐⭐⭐⭐" : s_score >= 3 ? "⭐⭐⭐" : s_score >= 2 ? "⭐⭐" : "⭐"
                    
                    sell_sl = close + atr_value * sl_atr_mult
                    sell_tp1 = close - (sell_sl - close) * rr_ratio_1
                    sell_tp2 = close - (sell_sl - close) * rr_ratio_2
                    risk_amount = account_bal * (risk_pct / 100.0)
                    
                    dist = math.abs(sell_sl - close)
                    units_to_sell = is_forex ? (risk_amount / (dist * 100000)) : (risk_amount / dist)
                    unit_label = is_forex ? "Lot: " : "Units: "
                    
                    lbl_text = "BÁN " + stars + "\n" + unit_label + str.tostring(units_to_sell, "#.##") + "\nVô: " + str.tostring(close, format.mintick)
                    if label_signals
                        label.new(bar_index, high, lbl_text, color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small)
                        
                    if show_sl_tp
                        line.new(bar_index, sell_sl, bar_index + future_sessions, sell_sl, color=color.new(color.red, 20),   width=1, style=line.style_dashed)
                        line.new(bar_index, sell_tp1, bar_index + future_sessions, sell_tp1, color=color.new(color.orange, 20), width=1, style=line.style_dashed)
                        line.new(bar_index, sell_tp2, bar_index + future_sessions, sell_tp2, color=color.new(color.green, 20), width=1, style=line.style_dashed)
                        label.new(bar_index + future_sessions, sell_sl, "SL " + str.tostring(sell_sl, format.mintick), color=color.new(color.red, 20),   style=label.style_label_left, textcolor=color.white, size=size.small)
                        label.new(bar_index + future_sessions, sell_tp1, "TP1 " + str.tostring(sell_tp1, format.mintick), color=color.new(color.orange, 20), style=label.style_label_left, textcolor=color.white, size=size.small)
                        label.new(bar_index + future_sessions, sell_tp2, "TP2 " + str.tostring(sell_tp2, format.mintick), color=color.new(color.green, 20), style=label.style_label_left, textcolor=color.white, size=size.small)

                    json_msg = "{\"action\": \"SELL\", \"symbol\": \"" + syminfo.ticker + "\", \"price\": " + str.tostring(close) + ", \"sl\": " + str.tostring(sell_sl) + ", \"tp1\": " + str.tostring(sell_tp1) + ", \"tp2\": " + str.tostring(sell_tp2) + ", \"size\": " + str.tostring(units_to_sell) + ", \"score\": " + str.tostring(s_score) + "}"
                    alert(json_msg, alert.freq_once_per_bar_close)

            array.set(active_zones, i, z)

// =====================================================
// 8) TREND SIGNAL ENGINE
// =====================================================
if barstate.isconfirmed
    if is_uptrend
        bull_streak := bull_streak + 1
        bear_streak := 0
    else if is_downtrend
        bear_streak := bear_streak + 1
        bull_streak := 0
    else
        bull_streak := 0
        bear_streak := 0
    if bull_streak == trend_confirm_bars
        trend_buy_signal := true
    if bear_streak == trend_confirm_bars
        trend_sell_signal := true

bgcolor_color = show_trend_bg ? (bull_streak >= trend_confirm_bars ? color.new(color.teal, 92) : bear_streak >= trend_confirm_bars ? color.new(color.red, 92) : na) : na
bgcolor(bgcolor_color, title="Trend Background")

plotshape(show_trend_signals and trend_buy_signal,  title="Trending Buy",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.aqua, 0),   size=size.small, text="▲ TĂNG",  textcolor=color.aqua)
plotshape(show_trend_signals and trend_sell_signal, title="Trending Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="▼ GIẢM", textcolor=color.orange)

// =====================================================
// 9) FUTURE PREDICTION + UPGRADED WIN-RATE ENGINE
// =====================================================
// Pre-calculate lowest/highest for SL check
lowest_future  = ta.lowest(low, math.max(1, future_sessions))
highest_future = ta.highest(high, math.max(1, future_sessions))

if barstate.isconfirmed
    if buy_signal or trend_buy_signal
        last_signal_type  := "BUY"
        last_signal_price := close
        array.push(wr_bars, bar_index)
        array.push(wr_prices, close)
        array.push(wr_sls, close - atr_value * sl_atr_mult)
        array.push(wr_dirs, 1)
    else if sell_signal or trend_sell_signal
        last_signal_type  := "SELL"
        last_signal_price := close
        array.push(wr_bars, bar_index)
        array.push(wr_prices, close)
        array.push(wr_sls, close + atr_value * sl_atr_mult)
        array.push(wr_dirs, -1)

    if array.size(wr_bars) > 0
        for j = array.size(wr_bars) - 1 to 0
            sig_bar   = array.get(wr_bars,   j)
            sig_price = array.get(wr_prices, j)
            sig_sl    = array.get(wr_sls,    j)
            sig_dir   = array.get(wr_dirs,   j)
            
            bars_passed = bar_index - sig_bar
            if bars_passed == future_sessions
                // Lỗ hổng đã được vá: Kiểm tra giá có quét Stop Loss trong thời gian future_sessions hay không
                sl_hit = false
                if sig_dir == 1 and lowest_future <= sig_sl
                    sl_hit := true
                else if sig_dir == -1 and highest_future >= sig_sl
                    sl_hit := true

                won = not sl_hit and (sig_dir == 1 ? close > sig_price : close < sig_price)
                
                if winrate_source != "Sell Only" and sig_dir == 1
                    buy_total := buy_total + 1
                    buy_wins  := won ? buy_wins + 1 : buy_wins
                if winrate_source != "Buy Only" and sig_dir == -1
                    sell_total := sell_total + 1
                    sell_wins  := won ? sell_wins + 1 : sell_wins
                    
                array.remove(wr_bars,   j)
                array.remove(wr_prices, j)
                array.remove(wr_sls,    j)
                array.remove(wr_dirs,   j)

if barstate.islast and show_future_pred and last_signal_type != "NONE"
    if not na(future_line)
        line.delete(future_line)
    if not na(future_label)
        label.delete(future_label)

    is_buy_pred = last_signal_type == "BUY"
    proj_color  = is_buy_pred ? color.new(color.aqua, 30) : color.new(color.orange, 30)
    proj_price  = is_buy_pred ? last_signal_price + atr_value * future_sessions * 0.1 : last_signal_price - atr_value * future_sessions * 0.1
    ls = pred_line_style == "Dashed" ? line.style_dashed : pred_line_style == "Dotted" ? line.style_dotted : line.style_solid

    future_line := line.new(bar_index, last_signal_price, bar_index + future_sessions, proj_price, color=proj_color, width=2, style=ls, extend=extend.none)

    total_samples = winrate_source == "Buy Only" ? buy_total : winrate_source == "Sell Only" ? sell_total : buy_total + sell_total
    total_wins    = winrate_source == "Buy Only" ? buy_wins  : winrate_source == "Sell Only" ? sell_wins  : buy_wins + sell_wins
    wr_pct      = total_samples >= winrate_min_samples ? math.round((total_wins / total_samples) * 100) : -1
    wr_acc_str  = wr_pct >= 0 ? ("\n🎯 Tỉ Lệ Thắng (Chuẩn SL): " + str.tostring(wr_pct) + "% (" + str.tostring(total_wins) + "/" + str.tostring(total_samples) + ")") : ("\n📊 Win-rate: Đang đo (< " + str.tostring(winrate_min_samples) + " lệnh)")
    wr_str      = show_winrate_label ? wr_acc_str : ""
    wr_color    = wr_pct >= 60 ? color.new(color.lime, 0) : wr_pct >= 40 ? color.new(color.yellow, 0) : wr_pct >= 0 ? color.new(color.red, 0) : color.new(color.gray, 0)

    arrow_sym = is_buy_pred ? "▲" : "▼"
    pred_dir  = is_buy_pred ? "TĂNG" : "GIẢM"
    future_label := label.new(bar_index + future_sessions, proj_price, arrow_sym + " DỰ BÁO " + pred_dir + "\n+" + str.tostring(future_sessions) + " nến" + wr_str, color=proj_color, style=is_buy_pred ? label.style_label_upper_left : label.style_label_lower_left, textcolor=color.black, size=size.small)

    if not na(winrate_label)
        label.delete(winrate_label)
    if show_winrate_label and wr_pct >= 0
        mid_bar   = bar_index + math.round(future_sessions / 2)
        mid_price = (last_signal_price + proj_price) / 2
        winrate_label := label.new(mid_bar, mid_price, str.tostring(wr_pct) + "%", color=wr_color, style=label.style_label_center, textcolor=color.black, size=size.normal)

// =====================================================
// 10) ALERTS
// =====================================================
alertcondition(buy_signal,        title="Mua Bắt Đáy",   message="Tín hiệu MUA tại Vùng Cầu | {{ticker}} | {{interval}} | {{close}}")
alertcondition(sell_signal,       title="Bán Đu Đỉnh",  message="Tín hiệu BÁN tại Vùng Cung | {{ticker}} | {{interval}} | {{close}}")
alertcondition(trend_buy_signal,  title="Mua Theo Trend",  message="MUA Theo Trend | {{ticker}} | {{interval}} | {{close}}")
alertcondition(trend_sell_signal, title="Bán Theo Trend", message="BÁN Theo Trend | {{ticker}} | {{interval}} | {{close}}")

// =====================================================
// 11) BẢNG ĐIỀU KHIỂN (VIETNAMESE CHECKLIST)
// =====================================================
var table stats_table = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast
    // [1] Khung Giờ (Session)
    sess_str = not is_intraday_chart ? "Bỏ Qua (Khung Lớn)" : (in_london and in_ny ? "London + NY" : in_london ? "London" : in_ny ? "New York" : "Đóng Cửa")
    sess_col = not is_intraday_chart ? color.new(color.gray, 50) : (in_session ? color.new(color.green, 20) : color.new(color.gray, 40))
    table.cell(stats_table, 0, 0, "[1] Phiên Giao Dịch", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 0, sess_str, bgcolor=sess_col, text_color=color.white)

    // [2] Xu Hướng HTF
    htf_str = htf_bull ? "▲ TĂNG (" + actual_htf + ")" : htf_bear ? "▼ GIẢM (" + actual_htf + ")" : "Không Rõ"
    htf_col = htf_bull ? color.new(color.green, 20) : htf_bear ? color.new(color.red, 20) : color.gray
    table.cell(stats_table, 0, 1, "[2] Xu Hướng Vĩ Mô", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 1, htf_str, bgcolor=htf_col, text_color=color.white)

    // [3] Xu Hướng HT (Regime)
    regime_str = is_uptrend ? "▲ TĂNG (BULL)" : is_downtrend ? "▼ GIẢM (BEAR)" : "ĐI NGANG"
    regime_col = is_uptrend ? color.new(color.green, 20) : is_downtrend ? color.new(color.red, 20) : color.gray
    table.cell(stats_table, 0, 2, "[3] Xu Hướng H.Tại", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 2, regime_str, bgcolor=regime_col, text_color=color.white)

    // [4] Khối Lượng
    vol_ratio_str = str.tostring(math.round(volume / vol_ma * 100) / 100) + "x Trung Bình"
    vol_row_col   = volume >= vol_ma * vol_surge_mult ? color.new(color.green, 20) : color.new(color.gray, 30)
    table.cell(stats_table, 0, 3, "[4] Khối Lượng (Vol)", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 3, vol_ratio_str, bgcolor=vol_row_col, text_color=color.white)

    // [5] Dải BB
    bb_pos_pct = (bb_upper - bb_lower) == 0 ? 50 : (close - bb_lower) / (bb_upper - bb_lower) * 100
    bb_pos_str = bb_pos_pct <= 20 ? "Chạm Đáy (" + str.tostring(math.round(bb_pos_pct, 1)) + "%)" : bb_pos_pct >= 80 ? "Đu Đỉnh (" + str.tostring(math.round(bb_pos_pct, 1)) + "%)" : "Nhập Nhằng (" + str.tostring(math.round(bb_pos_pct, 1)) + "%)"
    bb_row_col = bb_pos_pct <= 20 ? color.new(#089981, 20) : bb_pos_pct >= 80 ? color.new(#F23645, 20) : color.new(color.gray, 20)
    table.cell(stats_table, 0, 4, "[5] dải Bollinger", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 4, bb_pos_str, bgcolor=bb_row_col, text_color=color.white)

    // [6] RSI
    rsi_str = rsi_val <= rsi_os ? "Quá Bán Ngon " + str.tostring(math.round(rsi_val, 1)) : rsi_val >= rsi_ob ? "Quá Mua Rủi Ro " + str.tostring(math.round(rsi_val, 1)) : "Bình Thường " + str.tostring(math.round(rsi_val, 1))
    rsi_col = rsi_val <= rsi_os ? color.new(color.green, 20) : rsi_val >= rsi_ob ? color.new(color.red, 20) : color.new(color.gray, 30)
    table.cell(stats_table, 0, 5, "[6] Chỉ báo RSI", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 5, rsi_str, bgcolor=rsi_col, text_color=color.white)

    // [7] MACD Divergence
    div_str = bull_div ? "▲ Có Phân Kỳ Tăng" : bear_div ? "▼ Có Phân Kỳ Giảm" : "Không Mâu Thuẫn"
    div_col = bull_div ? color.new(color.green, 20) : bear_div ? color.new(color.red, 20) : color.new(color.gray, 40)
    table.cell(stats_table, 0, 6, "[7] Phân Kỳ MACD", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 6, div_str, bgcolor=div_col, text_color=color.white)

    // [8] Vùng Cản
    streak_val = bull_streak >= trend_confirm_bars ? "▲ Đà TĂNG Trend" : bear_streak >= trend_confirm_bars ? "▼ Đà GIẢM Trend" : "Hộp (Cản) Chờ: " + str.tostring(array.size(active_zones))
    streak_col = bull_streak >= trend_confirm_bars ? color.teal : bear_streak >= trend_confirm_bars ? color.red : color.new(color.blue, 20)
    table.cell(stats_table, 0, 7, "[8] Vị Thế Zone", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 7, streak_val, bgcolor=streak_col, text_color=color.white)

    // [9] Accuracy
    db_total = winrate_source == "Buy Only" ? buy_total : winrate_source == "Sell Only" ? sell_total : buy_total + sell_total
    db_wins  = winrate_source == "Buy Only" ? buy_wins  : winrate_source == "Sell Only" ? sell_wins  : buy_wins + sell_wins
    db_pct   = db_total >= winrate_min_samples ? math.round((db_wins / db_total) * 100) : -1
    db_pct_str = db_pct >= 0 ? str.tostring(db_pct) + "% (" + str.tostring(db_wins) + "/" + str.tostring(db_total) + " Lệnh)" : "Đang Đo Lường..."
    db_pct_col = db_pct >= 60 ? color.new(color.lime, 20) : db_pct >= 40 ? color.new(color.yellow, 20) : db_pct >= 0 ? color.new(color.red, 20) : color.gray
    table.cell(stats_table, 0, 8, "[9] Lịch Sử Thắng(W)", bgcolor=color.black, text_color=color.white)
    table.cell(stats_table, 1, 8, db_pct_str, bgcolor=db_pct_col, text_color=color.black)