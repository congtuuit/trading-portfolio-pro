{
  "manifest_version": 3,
  "name": "Trading Portfolio Pro",
  "version": "1.0.0",
  "description": "Track your trades and calculate real-time PnL with TradingView integration.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trading Portfolio Pro"
  },
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/tradingview-logo.png",
    "48": "icons/tradingview-logo.png",
    "128": "icons/tradingview-logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-loader.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "ui.js",
        "utils.js",
        "storage.js",
        "price.js",
        "pnl.js",
        "analysis.js",
        "ai.js",
        "style.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
